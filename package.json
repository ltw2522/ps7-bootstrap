{
  "name": "ps7-bootstrap",
  "description": "Install PowerShell 7 on Windows and pin the DeepSeek Harness shell to it.",
  "version": "0.2.4",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "docs",
    "index.js",
    "cordis.patch.yml",
    "scripts/ps7-bootstrap.ps1"
  ],
  "keywords": [
    "powershell",
    "powershell-7",
    "pwsh",
    "windows",
    "windows-terminal",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bootstrap"
  ],
  "author": "ltw2522",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltw2522/ps7-bootstrap.git"
  },
  "homepage": "https://github.com/ltw2522/ps7-bootstrap#readme",
  "bugs": {
    "url": "https://github.com/ltw2522/ps7-bootstrap/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
